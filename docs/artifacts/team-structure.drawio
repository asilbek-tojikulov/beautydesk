<mxfile><diagram name="Структура команды BeautyDesk"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="grp" value="Самоорганизующаяся команда разработки (открытая парадигма, Scrum)" style="rounded=1;dashed=1;fillColor=#f3faef;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#4d7a35;" vertex="1" parent="1"><mxGeometry x="150" y="240" width="800" height="280" as="geometry"/></mxCell><mxCell id="sp" value="Владелец сети (спонсор)&lt;br&gt;заказчик, бюджет, приёмка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="240" height="62" as="geometry"/></mxCell><mxCell id="po" value="Владелец продукта&lt;br&gt;Нигора Рахимова, управляющая" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="130" width="240" height="62" as="geometry"/></mxCell><mxCell id="us" value="Пользователи&lt;br&gt;администраторы и мастера салонов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="130" width="240" height="62" as="geometry"/></mxCell><mxCell id="sm" value="Scrum-мастер&lt;br&gt;Асилбек Тожикулов, фасилитатор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="285" width="200" height="62" as="geometry"/></mxCell><mxCell id="be" value="Backend-разработчик&lt;br&gt;Бахтиёр Юсупов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="190" y="410" width="200" height="72" as="geometry"/></mxCell><mxCell id="fe" value="Frontend / UX&lt;br&gt;Мадина Алиева" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="450" y="410" width="200" height="72" as="geometry"/></mxCell><mxCell id="qa" value="Аналитик-тестиро